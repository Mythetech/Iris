@using Iris.Contracts.Templates.Models
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size

<div class="template-card">
    <MudPaper Outlined="true" Class="pa-3 mb-2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@IrisIcons.Templates" Size="Size.Small" />

            @if (_editing)
            {
                <MudTextField @ref="_nameField"
                              T="string"
                              Value="@Template.Name"
                              ValueChanged="OnNameChanged"
                              OnBlur="@(() => _editing = false)"
                              Underline="false"
                              Class="flex-grow-1" />
            }
            else
            {
                <MudText Typo="Typo.body2"
                         Class="flex-grow-1 cursor-pointer text-truncate"
                         @onclick="@(() => OnPreview.InvokeAsync(Template))">
                    @Template.Name
                </MudText>
            }

            <div class="template-card-inline">
                <MudTooltip Text="Preview">
                    <MudIconButton Icon="@IrisIcons.Preview" Size="Size.Small" aria-label="Preview"
                                   OnClick="@(() => OnPreview.InvokeAsync(Template))" />
                </MudTooltip>
                <MudTooltip Text="Edit">
                    <MudIconButton Icon="@IrisIcons.Editor" Size="Size.Small" aria-label="Edit"
                                   OnClick="@OpenEditor" />
                </MudTooltip>
                <MudTooltip Text="Copy JSON">
                    <MudIconButton Icon="@IrisIcons.Copy" Size="Size.Small" aria-label="Copy JSON"
                                   Class="tier-copy"
                                   OnClick="@(() => OnCopy.InvokeAsync(Template))" />
                </MudTooltip>
                <MudTooltip Text="Duplicate">
                    <MudIconButton Icon="@IrisIcons.Duplicate" Size="Size.Small" aria-label="Duplicate"
                                   Class="tier-wide"
                                   OnClick="@(() => OnDuplicate.InvokeAsync(Template))" />
                </MudTooltip>
                <MudTooltip Text="Export">
                    <MudIconButton Icon="@IrisIcons.Export" Size="Size.Small" aria-label="Export"
                                   Class="tier-wide"
                                   OnClick="@(() => OnExport.InvokeAsync(Template))" />
                </MudTooltip>
                <MudTooltip Text="Rename">
                    <MudIconButton Icon="@IrisIcons.Edit" Size="Size.Small" aria-label="Rename"
                                   Class="tier-wide"
                                   OnClick="@StartRename" />
                </MudTooltip>
                <MudTooltip Text="Delete">
                    <MudIconButton Icon="@IrisIcons.Delete" Size="Size.Small" Color="Color.Error" aria-label="Delete"
                                   Class="tier-wide"
                                   OnClick="@(() => OnDelete.InvokeAsync(Template))" />
                </MudTooltip>
            </div>

            <div class="template-card-overflow">
                <MudMenu Icon="@IrisIcons.MoreOptions"
                         Size="Size.Small"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@IrisIcons.Copy" Class="tier-copy-menu"
                                 OnClick="@(() => OnCopy.InvokeAsync(Template))">Copy JSON</MudMenuItem>
                    <MudMenuItem Icon="@IrisIcons.Duplicate"
                                 OnClick="@(() => OnDuplicate.InvokeAsync(Template))">Duplicate</MudMenuItem>
                    <MudMenuItem Icon="@IrisIcons.Export"
                                 OnClick="@(() => OnExport.InvokeAsync(Template))">Export</MudMenuItem>
                    <MudMenuItem Icon="@IrisIcons.Edit"
                                 OnClick="@StartRename">Rename</MudMenuItem>
                    <MudMenuItem Icon="@IrisIcons.Delete" IconColor="Color.Error"
                                 OnClick="@(() => OnDelete.InvokeAsync(Template))">Delete</MudMenuItem>
                </MudMenu>
            </div>
        </MudStack>
    </MudPaper>
</div>

@code {
    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    [Parameter, EditorRequired]
    public Template Template { get; set; } = default!;

    [Parameter]
    public EventCallback<Template> OnPreview { get; set; }

    [Parameter]
    public EventCallback<Template> OnCopy { get; set; }

    [Parameter]
    public EventCallback<Template> OnExport { get; set; }

    [Parameter]
    public EventCallback<Template> OnDuplicate { get; set; }

    [Parameter]
    public EventCallback<Template> OnDelete { get; set; }

    [Parameter]
    public EventCallback<Template> OnRenamed { get; set; }

    private bool _editing;
    private MudTextField<string>? _nameField;

    private void OpenEditor() => NavigationManager.NavigateTo($"/Templates/{Template.TemplateId}");

    private async Task StartRename()
    {
        _editing = true;
        StateHasChanged();

        if (_nameField is not null)
            await _nameField.FocusAsync();
    }

    private async Task OnNameChanged(string name)
    {
        Template.Name = name;
        _editing = false;
        await OnRenamed.InvokeAsync(Template);
    }
}
