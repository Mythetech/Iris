@using Iris.Components.Theme
@using Iris.Sagas

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIcon Color="Color.Warning" Class="mr-4" Icon="@IrisIcons.Warning" />
            <MudText Typo="Typo.h6">Unmatched transitions</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <div class="unmatched-dialog">
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                These spans described a saga transition, but Iris could not tell which loaded state machine they belong to.
                Two state machines sharing a class name, or an assembly that is not loaded, are the usual causes.
            </MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Summary</MudText>
            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="unmatched-table mt-2">
                <thead>
                    <tr>
                        <th>Saga id</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Type hint</th>
                        <th>Trace id</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transition in _transitions)
                    {
                        <tr>
                            <td class="unmatched-mono">@transition.SagaId</td>
                            <td>@transition.BeginState</td>
                            <td>@transition.EndState</td>
                            <td>@(transition.SagaTypeHint ?? "none")</td>
                            <td class="unmatched-mono">@transition.TraceId</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject] SagaInstanceState Instances { get; set; } = default!;

    private IReadOnlyList<SagaTransition> _transitions = [];
    private int _total;

    protected override void OnInitialized()
    {
        _total = Instances.UnmatchedCount;
        _transitions = Instances.Unmatched.Reverse().ToList();
    }

    // The sample is capped at MaxUnmatched while the count keeps rising, so the table is often a window
    // onto a larger number. Say so rather than letting the row count read as the whole story.
    private string Summary => _total > _transitions.Count
        ? $"The {_transitions.Count} most recent of {_total} unmatched transitions, newest first."
        : $"{_total} unmatched transitions, newest first.";

    private void Close() => MudDialog.Cancel();
}
