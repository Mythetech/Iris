@using Iris.Components.Shared.Time
@using Mythetech.Framework.Components.Buttons

<div class="saga-instance-panel">
    <MudText Typo="Typo.subtitle2" Class="px-2 pt-2">Instances</MudText>

    @if (Instances.Count == 0)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="w-100 flex-grow-1 py-6">
            <MudIcon Icon="@IrisIcons.NoSagas" Size="Size.Large" Class="mud-text-secondary mb-2" />
            <MudText Typo="Typo.body2" Align="MudBlazor.Align.Center" Class="mud-text-secondary">
                No instances yet. Instances appear once the OTLP receiver is running and your app exports saga spans to it.
            </MudText>
        </MudStack>
    }
    else
    {
        <MudList T="Guid?" Dense="true" Class="saga-instance-list"
                 SelectionMode="SelectionMode.ToggleSelection"
                 SelectedValue="@Selected?.SagaId"
                 SelectedValueChanged="OnSelectedValueChangedAsync">
            @foreach (var instance in Instances)
            {
                <MudListItem T="Guid?" Dense="true" Value="@instance.SagaId" Class="saga-instance-item">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2" Class="saga-id">@ShortId(instance.SagaId)</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @instance.CurrentState, @TransitionCountLabel(instance)
                            </MudText>
                        </MudStack>
                        <MtCopyButton Text="@instance.SagaId.ToString("D")" CopyTooltip="Copy saga id" Size="Size.Small" />
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }

    @if (Selected is { } selected)
    {
        <MudDivider Class="my-1" />
        <MudText Typo="Typo.subtitle2" Class="px-2">@TimelineHeading(selected)</MudText>
        @if (IsCapped(selected))
        {
            <MudText Typo="Typo.caption" Class="px-2 mud-text-secondary">
                Older transitions were dropped. First seen <LocalTime DateTimeOffset="selected.FirstSeen" />.
            </MudText>
        }
        <div class="saga-timeline">
            @foreach (var transition in selected.Transitions.Reverse())
            {
                var isExpanded = _expandedSpanId == transition.SpanId;
                <div class="saga-timeline-row">
                    <MudIconButton Icon="@(isExpanded ? IrisIcons.ExpandMore : IrisIcons.ChevronRight)"
                                   Size="Size.Small"
                                   Class="span-toggle"
                                   aria-expanded="@(isExpanded ? "true" : "false")"
                                   aria-label="@(isExpanded ? "Hide span" : "Show span")"
                                   OnClick="@(() => ToggleRow(transition.SpanId))" />
                    <div class="saga-timeline-content">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary"><LocalTime DateTimeOffset="transition.Timestamp" /></MudText>
                        <MudText Typo="Typo.body2">@transition.BeginState to @transition.EndState</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@transition.EventName</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                            <MudText Typo="Typo.caption" Class="saga-trace-id">@ShortTraceId(transition.TraceId)</MudText>
                            <MtCopyButton Text="@transition.TraceId" CopyTooltip="Copy trace id" Size="Size.Small" />
                        </MudStack>
                    </div>
                </div>

                @if (isExpanded)
                {
                    @if (transition.Span is { } span)
                    {
                        <SpanDetail Span="span" />
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary saga-span-dropped">
                            The span behind this transition is no longer retained. Iris keeps the last
                            @SagaInstanceState.MaxRetainedSpansPerInstance per instance.
                        </MudText>
                    }
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<SagaInstance> Instances { get; set; } = [];
    [Parameter] public SagaInstance? Selected { get; set; }
    [Parameter] public EventCallback<SagaInstance?> SelectedChanged { get; set; }

    // Identified by span id rather than by position: the timeline is live and newest first, so an
    // index would quietly slide onto a different transition as spans arrive. A span id is unique,
    // survives the list growing, and matches nothing on another instance's timeline.
    private string? _expandedSpanId;

    private void ToggleRow(string spanId) => _expandedSpanId = _expandedSpanId == spanId ? null : spanId;

    private Task OnSelectedValueChangedAsync(Guid? sagaId)
        => SelectedChanged.InvokeAsync(sagaId is null ? null : Instances.FirstOrDefault(i => i.SagaId == sagaId));

    // Instances hold at most MaxTransitionsPerInstance transitions, so a full list means the
    // oldest were dropped and neither the count nor the last row can be taken at face value.
    private static bool IsCapped(SagaInstance instance)
        => instance.Transitions.Count >= SagaInstanceState.MaxTransitionsPerInstance;

    private static string TransitionCountLabel(SagaInstance instance)
        => IsCapped(instance)
            ? $"{SagaInstanceState.MaxTransitionsPerInstance}+ transitions"
            : $"{instance.Transitions.Count} transition{(instance.Transitions.Count == 1 ? "" : "s")}";

    private static string TimelineHeading(SagaInstance instance)
        => IsCapped(instance)
            ? $"Timeline, newest first, last {SagaInstanceState.MaxTransitionsPerInstance}"
            : "Timeline, newest first";

    private static string ShortId(Guid id) => id.ToString("N")[..8];

    private static string ShortTraceId(string traceId) => traceId[..Math.Min(12, traceId.Length)];
}
