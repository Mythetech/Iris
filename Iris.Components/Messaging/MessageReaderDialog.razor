@using Iris.Contracts.Brokers.Models
@using Iris.Components.Theme

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIcon Icon="@IrisIcons.ReadMessages" />
            <MudText Typo="Typo.h6">Read @Endpoint.Name</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MessageReaderPanel Endpoint="@Endpoint" Capabilities="@Capabilities" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public EndpointDetails Endpoint { get; set; } = default!;
    [Parameter, EditorRequired] public ReaderCapabilitiesDto Capabilities { get; set; } = default!;

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
