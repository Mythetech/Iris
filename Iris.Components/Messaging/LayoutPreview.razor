<MudStack Spacing="1">
    <MudText Class="mud-text-secondary align-self-center">@LayoutName</MudText>
    <MudStack Row AlignItems="AlignItems.Center">
        <MudText Typo="Typo.body2" Class="mud-text-secondary layout-zone-label">Top Zone</MudText>
        @foreach (var tab in Layout.Where(x => x is { AreaIdentifier: LayoutZones.TopZone }).OrderBy(y => y.AreaIndex))
        {
            <MudText>@tab.Name</MudText>
        }
    </MudStack>
    <MudStack Row AlignItems="AlignItems.Center">
        <MudText Typo="Typo.body2" Class="mud-text-secondary layout-zone-label">Bottom Zone</MudText>
        @foreach (var tab in Layout.Where(x => x is { AreaIdentifier: LayoutZones.BottomZone }).OrderBy(y => y.AreaIndex))
        {
            <MudText>@tab.Name</MudText>
        }
    </MudStack>
</MudStack>

@code {
    [Parameter]
    public List<DynamicTabView> Layout { get; set; }

    [Parameter] public string LayoutName { get; set; } = "Default";
}