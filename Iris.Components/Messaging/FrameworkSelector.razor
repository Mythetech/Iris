@using Iris.Components.Messaging
@using Iris.Components.Theme
@using Iris.Components.Messaging
@using Iris.Components.Theme
@using Iris.Contracts.Messaging.Frameworks
@inherits DynamicTabView
@implements IDisposable

<MudStack>
    <MudSelect Value="@MessageState.SelectedFramework"
               ValueChanged="@OnFrameworkChanged"
               Dense="true" T="string" Label="Framework" Variant="Variant.Text" Clearable="true"
               HelperText="@MessageState.FrameworkNotice">
        @foreach (var framework in MessageState.AvailableFrameworks)
        {
            <MudSelectItem T="string" Value="@framework.Name" Disabled="@(!framework.Supported)">
                @if (TooltipFor(framework) is { } tooltip)
                {
                    <MudTooltip Text="@tooltip"><span>@framework.Name</span></MudTooltip>
                }
                else
                {
                    <span>@framework.Name</span>
                }
            </MudSelectItem>
        }
    </MudSelect>

    @if (MessageState.SelectedFramework != null)
    {
        <MudDataGrid Class="iris-table" Hover="true" Dense="true" T="DictionaryViewModel" Items="@MessageState.AdditionalProperties" ReadOnly="false"
                     EditMode="DataGridEditMode.Cell"
                     ColumnResizeMode="ResizeMode.Column">
            <ToolBarContent>
                <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Additional Properties</MudText>
            
                <MudSpacer />
                <IconTextButton 
                    OnClick="@(() => MessageState.AddAdditionalProperty(new DictionaryViewModel { Key = "Untitled", Value = "" }))" 
                    Icon="@IrisIcons.Add" 
                    Text="Add Property"
                />
            </ToolBarContent>
            <Columns>
                <TemplateColumn CellClass="grid-icon-col">
                    <EditTemplate>
                        @if (!string.IsNullOrWhiteSpace(context?.Item?.Description))
                        {
                            <MudTooltip Text="@context.Item.Description">
                                <span style="width:30px">
                                    <MudIcon Size="Size.Small" Icon="@IrisIcons.Info" Class="mb-3" Color="Color.Info" />
                                </span>
                            </MudTooltip>
                        }
                    </EditTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x!.Key" Title="Property">
                    <EditTemplate>
                        @* A framework input is looked up by this exact key, so renaming one would
                           drop it silently. Only rows the user added by hand are renameable. *@
                        @if (context.Item.Immutable)
                        {
                            <span>@context.Item.Key</span>
                        }
                        else
                        {
                            <MudTextField T="string" @bind-Value="context.Item.Key" Margin="Margin.Dense" />
                        }
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x!.Value" Title="Value">
                    <EditTemplate>
                        @if (context.Item.AllowedValues is { Count: > 0 } allowed)
                        {
                            <MudSelect T="string" @bind-Value="context.Item.Value" Dense="true" Margin="Margin.Dense">
                                @foreach (var value in allowed)
                                {
                                    <MudSelectItem T="string" Value="@value">@value</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudTextField T="string" @bind-Value="context.Item.Value" Margin="Margin.Dense"
                                          Error="@(context.Item.Required && string.IsNullOrWhiteSpace(context.Item.Value))"
                                          ErrorText="Required" />
                        }
                    </EditTemplate>
                </PropertyColumn>
                <TemplateColumn CellClass="grid-icon-col">
                    <CellTemplate>
                        <span style="width:30px;float:right;">
                            <IconButton Class="icon-btn-danger bg-transparent" Name="@IrisIcons.Delete" Title="Delete Property" Disabled="@context.Item.Immutable" ButtonClicked="@(() => MessageState.RemoveAdditionalProperty(context.Item))" />
                        </span>
                    </CellTemplate>
                    <EditTemplate>
                        <span style="width:30px;float:right;">
                            <IconButton Class="icon-btn-danger bg-transparent" Name="@IrisIcons.Delete" Title="Delete Property" Disabled="@context.Item.Immutable" ButtonClicked="@(() => MessageState.RemoveAdditionalProperty(context.Item))" />
                        </span>
                    </EditTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
</MudStack>

@code {
    [Inject]
    public MessageState MessageState { get; set; } = default!;

    public override string Name { get; set; } = "Frameworks";

    public override Type ComponentType { get; set; } = typeof(FrameworkSelector);

    protected override void OnInitialized()
    {
        MessageState.StateChanged += OnStateChanged;
    }

    private void OnStateChanged() => StateHasChanged();

    public void Dispose()
    {
        MessageState.StateChanged -= OnStateChanged;
    }

    private void OnFrameworkChanged(string? name)
        => MessageState.SetFramework(MessageState.AvailableFrameworks.FirstOrDefault(f => f.Name == name));

    private static string? TooltipFor(FrameworkDescriptor framework)
    {
        if (!framework.Supported)
            return framework.UnsupportedReason;

        var parts = new List<string>();

        if (!framework.Verified)
            parts.Add("Not verified against this provider's consumer; the wire shape follows RabbitMQ.");

        if (framework.DroppedKeys is { Count: > 0 } dropped)
            parts.Add($"{dropped.Count} optional headers not sent: {string.Join(", ", dropped)}");

        return parts.Count == 0 ? null : string.Join(" ", parts);
    }
}