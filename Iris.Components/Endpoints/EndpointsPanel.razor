@using Iris.Components.Theme
@using Iris.Components.Brokers

<ContextPanelLayout Title="Endpoints" PageHref="/Endpoints">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="align-self-center my-4" />
    }
    else if (_endpoints == null || _endpoints.Count == 0)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="w-100 flex-grow-1">
            <MudIcon Icon="@IrisIcons.NoEndpoints" Size="Size.Large" Class="mud-text-secondary mb-2" />
            <MudText Typo="Typo.body2" Align="MudBlazor.Align.Center" Class="mud-text-secondary">
                No endpoints discovered
            </MudText>
        </MudStack>
    }
    else
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
            @_endpoints.Count endpoint@(_endpoints.Count != 1 ? "s" : "") across @_groupedEndpoints.Count provider@(_groupedEndpoints.Count != 1 ? "s" : "")

        </MudText>

        <MudList T="string" Dense="true">
            @foreach (var group in _groupedEndpoints)
            {
                <MudListSubheader>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.caption" Class="text-truncate">@group.Key</MudText>
                        <MudSpacer />
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@(group.Count())</MudChip>
                    </MudStack>
                </MudListSubheader>
                @foreach (var endpoint in group.Take(10))
                {
                    <MudListItem T="string" Dense="true">
                        <button type="button"
                                class="endpoints-panel-row"
                                @onclick="@(() => ShowDetailsAsync(endpoint))">
                            <MudText Typo="Typo.body2" Class="text-truncate">@endpoint.Name</MudText>
                        </button>
                    </MudListItem>
                }
                @if (group.Count() > 10)
                {
                    <MudListItem T="string" Dense="true">
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   Class="endpoints-panel-more"
                                   OnClick="@OpenEndpointsPage">
                            +@(group.Count() - 10) more
                        </MudButton>
                    </MudListItem>
                }
            }
        </MudList>
    }
</ContextPanelLayout>

@code {
    [Inject] IBrokerService BrokerClient { get; set; } = default!;
    [Inject] IDialogService DialogService { get; set; } = default!;
    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    private List<EndpointDetails>? _endpoints;
    private List<IGrouping<string, EndpointDetails>> _groupedEndpoints = new();
    private bool _loading = true;

    // Keyed by broker address, same shape as the Endpoints page's cache, so a
    // second click on an endpoint whose broker was already probed does not
    // re-query it.
    private readonly Dictionary<string, ReaderCapabilitiesDto?> _capsCache = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _endpoints = await BrokerClient.GetEndpointsAsync();
        _groupedEndpoints = _endpoints?.GroupBy(e => e.Address).ToList() ?? new();
        _loading = false;
    }

    private async Task ShowDetailsAsync(EndpointDetails endpoint)
    {
        if (!_capsCache.TryGetValue(endpoint.Address, out var caps))
        {
            caps = await BrokerClient.GetReaderCapabilitiesAsync(endpoint.Address);
            _capsCache[endpoint.Address] = caps;
        }

        var parameters = new DialogParameters
        {
            { nameof(EndpointDetailsDialog.Endpoint), endpoint },
            { nameof(EndpointDetailsDialog.CanRead), EndpointReadPolicy.CanRead(endpoint, caps) },
            { nameof(EndpointDetailsDialog.ReadDisabledReason), EndpointReadPolicy.DisabledReason(endpoint) },
        };

        await DialogService.ShowAsync<EndpointDetailsDialog>(
            endpoint.Name,
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true, NoHeader = true });
    }

    private void OpenEndpointsPage() => NavigationManager.NavigateTo("/Endpoints");
}
