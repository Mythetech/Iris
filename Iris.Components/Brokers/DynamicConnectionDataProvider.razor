@using Iris.Components.Infrastructure
<MudStack Class="mud-width-full">
    @if (Provider == null || _providerDataType == null)
    {
        <ProtectedTextField Dense="true" Label="Connection String" @bind-Value="@_connectionString" />
    }
    else
    {
        <DynamicComponent @ref="_dynamicConnectionDataComponent"
                          Type="@_providerDataType"
                          Parameters="_parameters"></DynamicComponent>
    }
</MudStack>

@code {
    [Inject]
    public ComponentRegistry<IConnectionDataProvider> DataProviderRegistry { get; set; } = default!;

    private ConnectionData Data { get; set; } = new()
    {
        ConnectionString = string.Empty,
    };

    public ConnectionData GetData()
    {
        // _providerDataType is the authority on which branch rendered. The @ref can outlive
        // the component when the selection moves to a provider with no registered view, and
        // reading its payload then would return the previous provider's data.
        if (_providerDataType is not null
            && _dynamicConnectionDataComponent?.Instance is IConnectionDataProvider provider)
            return provider.Payload;

        Data.ConnectionString = _connectionString;
        return Data;
    }

    [Parameter]
    public SupportedProvider? Provider { get; set; }

    private DynamicComponent? _dynamicConnectionDataComponent;

    private Type? _providerDataType;

    private string _connectionString = "";

    private IDictionary<string, object>? _parameters;

    protected override void OnParametersSet()
    {
        if (DataProviderRegistry.TryResolve(out var providerDataType, Provider?.Name))
        {
            _providerDataType = providerDataType;
            _parameters = new Dictionary<string, object> { ["Data"] = Data };
        }
        else
        {
            _providerDataType = null;
        }

        StateHasChanged();
    }
}

