<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageVersion Include="Nerdbank.GitVersioning" Version="3.6.141">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </GlobalPackageVersion>
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.2.24" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <PackageVersion Include="Azure.Storage.Queues" Version="12.25.0" />
    <PackageVersion Include="EasyNetQ" Version="8.1.7" />
    <PackageVersion Include="EasyNetQ.Management.Client" Version="3.0.1" />
    <PackageVersion Include="LiteDB" Version="5.0.21" />
    <!-- MassTransit 9.x is commercially licensed and refuses to build a bus without a license key.
         Stay on the 8.x line. The saga sample and the reflector both depend on this. -->
    <PackageVersion Include="MassTransit" Version="8.5.10" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.10" />
    <PackageVersion Include="MassTransit.AmazonSQS" Version="8.5.10" />
    <PackageVersion Include="MassTransit.Azure.ServiceBus.Core" Version="8.5.10" />
    <!-- 4.x, not the latest: the only consumer is a netstandard2.0 source generator,
         which has to load into the compiler's own Roslyn. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="NServiceBus" Version="10.1.1" />
    <!-- Test-only. 14.0.0 is the last ASQ transport that accepts NServiceBus 10.1.1;
         14.0.1 and later require 10.1.4 or newer. Bump both together or neither. -->
    <PackageVersion Include="NServiceBus.Transport.AzureStorageQueues" Version="14.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <PackageVersion Include="Rebus" Version="8.9.0" />
    <PackageVersion Include="Rebus.RabbitMq" Version="10.1.1" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="5.29.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <!-- Added to every test project by Directory.Build.targets, not by csproj. Replaces
         coverlet.collector, which only works under VSTest; Iris runs on Microsoft.Testing.Platform. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <!-- Stays below 8.0: FluentAssertions moved to a paid commercial licence at 8, so 7.x
         is the last free line. Treat this the way the MassTransit pin below is treated. -->
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="bunit" Version="2.11.3" />
    <PackageVersion Include="BlazorMonaco" Version="3.3.0" />
    <PackageVersion Include="PSC.Blazor.Components.Chartjs" Version="8.0.8" />
    <PackageVersion Include="Microsoft.Fast.Components.FluentUI" Version="3.7.8" />
    <PackageVersion Include="Toolbelt.Blazor.LoadingBar" Version="14.0.0" />
    <PackageVersion Include="Toolbelt.Blazor.ViewTransition" Version="2.0.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.0.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.0.0" />
    <PackageVersion Include="Docker.DotNet" Version="3.125.15" />
    <PackageVersion Include="Mythetech.Framework" Version="0.19.5" />
    <PackageVersion Include="Mythetech.Framework.Desktop" Version="0.19.2" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.1" />
    <PackageVersion Include="Grpc.Tools" Version="2.83.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Paramore.Brighter.MessagingGateway.RMQ.Async" Version="10.3.3" />
  </ItemGroup>
</Project>